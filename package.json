{
  "name": "dsh-pet-one",
  "version": "0.1.0",
  "description": "All-in-one desktop pet for DeepSeek Harness Web: agent-state mirror, affinity & treats economy, balance/usage dashboard, skin & Codex-atlas import, synthesized sounds.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "NOTICE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "whale"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "preview": "python3 -m http.server 8765 --directory preview"
  }
}
